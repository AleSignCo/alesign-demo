      "destination": "/api/site-preview?token=:token&id=:id"
    },
    {
      "source": "/api/site-preview",
      "destination": "/api/site-preview"
    },
    {
      "source": "/api/meta-connect",
      "destination": "/api/meta-connect"
    },
    {
      "source": "/api/meta-callback",
      "destination": "/api/meta-callback"
    },
    {
      "source": "/api/meta-deconectare",
      "destination": "/api/meta-deconectare"
    },
    {
      "source": "/api/site-build",
      "destination": "/api/site-build"
    },
    {
      "source": "/api/qa-dovada",
      "destination": "/api/qa-dovada"
    },
    {
      "source": "/api/spatiu-comentariu",
      "destination": "/api/spatiu-comentariu"
    },
    {
      "source": "/api/spatiu-aproba",
      "destination": "/api/spatiu-aproba"
    },
    {
      "source": "/api/transe-plan",
      "destination": "/api/transe-plan"
    },
    {
      "source": "/t/:token",
      "destination": "/api/transa?token=:token"
    },
    {
      "source": "/e/:slug",
      "destination": "/api/raport-site?slug=:slug"
    },
    {
      "source": "/s/:token",
      "destination": "/api/spatiu?token=:token"
    },
    {
      "source": "/panou",
      "destination": "/panou.html"
    },
    {
      "source": "/api/panou-date",
      "destination": "/api/panou-date"
    },
    {
      "source": "/liber",
      "destination": "/liber.html"
    },
    {
      "source": "/dovada",
      "destination": "/dovada.html"
    },
    {
      "source": "/api/aplicare",
      "destination": "/api/aplicare"
    },
    {
      "source": "/",
      "destination": "/api/site"
    },
    {
      "source": "/:slug",
      "destination": "/api/site?slug=:slug"
    },
    {
      "source": "/api/monitor",
      "destination": "/api/monitor"
    },
    {
      "source": "/api/factura",
      "destination": "/api/factura"
    },
    {
      "source": "/care/:token",
      "destination": "/api/care?token=:token"
    },
    {
      "source": "/api/spatiu-incheie",
      "destination": "/api/spatiu-incheie"
    }
  ],
  "headers": [
    {
      "source": "/poze/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
