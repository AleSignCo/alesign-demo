{
  "rewrites": [
    { "source": "/poze/(.*)", "destination": "/poze/$1" },
    { "source": "/", "destination": "/api/site" },
    { "source": "/:slug", "destination": "/api/site?slug=:slug" }
  ],
  "headers": [
    { "source": "/poze/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
